# === GigaChat (Sber) ===
# Keys from https://developers.sber.ru (GigaChat API -> Quick start)
GIGACHAT_CLIENT_ID=
# The secret may be either the raw CLIENT_SECRET or the full base64 blob
# copied from the Sber console ("Authorization: Basic <blob>") - both work.
GIGACHAT_CLIENT_SECRET=
GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_API_PERS - individuals, GIGACHAT_API_CORP / GIGACHAT_API_B2B - business
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# false if Sber's certificate chain fails SSL verification (common case)
GIGACHAT_VERIFY_SSL=false
# Base URL (since 17.07.2026 - api.giga.chat; older accounts - gigachat.devices.sberbank.ru)
GIGACHAT_BASE_URL=https://api.giga.chat

# === YandexGPT (Yandex Cloud) ===
# API key from https://console.cloud.yandex.ru (Results -> Access to API) or an IAM token
YANDEX_API_KEY=
# Catalog (folder) id from the console home page
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# === Custom / OpenAI-compatible API ===
# Works with OpenAI, OpenRouter, DeepSeek, Ollama (http://localhost:11434/v1) etc.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
